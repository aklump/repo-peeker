{
    "name": "aklump/repo-peeker",
    "description": "Repo Peeker (gitpeek) - a TempestPHP console tool that inspects a folder of git projects, tree-style.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "tempest/console": "^2.14",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "bamarni/composer-bin-plugin": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "RepoPeeker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/gitpeek"
    ],
    "scripts": {
        "phpunit": "vendor/bin/phpunit --display-warnings --display-skipped --display-deprecations --display-errors --display-notices",
        "build": "box compile"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}

#!/usr/bin/env php
<?php

use RepoPeeker\ConsoleCommands;
use Tempest\Console\ConsoleApplication;
use Tempest\Console\ConsoleConfig;
use Tempest\Core\Tempest;

$root = dirname(__DIR__);

require_once $root . '/vendor/autoload.php';

if (count($_SERVER['argv']) < 2) {
    $_SERVER['argv'][] = 'status';
}

// When running as a compiled .phar, $root points inside the (read-only)
// archive, so Tempest's default internal storage location ($root/.tempest)
// can't be created there. Redirect it to a writable, per-user cache
// directory instead; a normal checkout keeps using $root/.tempest as before.
$internalStorage = Phar::running() !== ''
    ? sys_get_temp_dir() . '/gitpeek'
    : null;

$container = Tempest::boot($root, internalStorage: $internalStorage);

$consoleConfig = $container->get(ConsoleConfig::class);
$consoleConfig->name = 'gitpeek';
ConsoleCommands::restrictToApp($consoleConfig);

$container->get(ConsoleApplication::class)->run();

exit;
